#!/bin/bash
# tandem-as: run jcode as a per-account Linux user, creating it on demand.
# Installed root-owned at /usr/local/sbin/tandem-as. The worker (user sid) may
# only call this via a narrow sudoers rule. Usage:
#   tandem-as <account-key> <cwd> -- jcode <args...>
#   tandem-as <account-key> <cwd> --grant      # give this account access to one workspace
# account-key: 1-40 chars [a-z0-9]. Linux user becomes tdu_<key>.
#
# Workspaces are private per directory: no group access, only ACL entries for
# the worker and for the accounts that are members (granted by the worker when
# a member's run is claimed). So an agent can only touch workspaces its owner
# belongs to.
set -euo pipefail
key="$1"; cwd="$2"; shift 2
[[ "$key" =~ ^[a-z0-9]{1,40}$ ]] || { echo "bad key" >&2; exit 2; }
user="tdu_${key:0:28}"
WS_ROOT=/srv/tandem/workspaces
WORKER_USER=$(stat -c %U "$WS_ROOT")
case "$cwd" in
  "$WS_ROOT"/*) ;;
  *) echo "cwd must be inside $WS_ROOT" >&2; exit 2 ;;
esac
cwd_real=$(realpath -e "$cwd")
[[ "$cwd_real" == "$WS_ROOT"/* ]] || { echo "cwd escapes root" >&2; exit 2; }
# The top-level workspace dir this cwd belongs to.
rel="${cwd_real#"$WS_ROOT"/}"
top="$WS_ROOT/${rel%%/*}"
[ "$(stat -c %U "$top")" = "$WORKER_USER" ] || { echo "workspace not owned by worker" >&2; exit 2; }

if ! id -u "$user" >/dev/null 2>&1; then
  useradd --system --create-home --home-dir "/srv/tandem/homes/$user" \
    --shell /usr/sbin/nologin --gid tandem "$user"
  chmod 700 "/srv/tandem/homes/$user"
fi
home="/srv/tandem/homes/$user"
install -d -m 700 -o "$user" -g tandem "$home/tmp"

# Lock the workspace to its ACL list (idempotent): no group/other access.
lock() {
  chmod 2770 "$top"
  setfacl -m g::---,o::---,u:"$WORKER_USER":rwx,m::rwx "$top"
  setfacl -d -m g::---,o::---,u:"$WORKER_USER":rwx,m::rwx "$top"
}

if [ "${1:-}" = "--grant" ]; then
  lock
  setfacl -R -m u:"$user":rwX "$top"
  setfacl -R -d -m u:"$user":rwX "$top"
  exit 0
fi

# Shared pane memory. The master copy of each pane's Jcode session lives in a
# root-only dir. It is copied into the prompter's sandbox before a run and
# back out after, always reading/writing the sandbox side AS that user, so a
# symlink planted by an agent can never make root touch other files.
SESS_ROOT=/srv/tandem/sessions
as_user() { setpriv --reuid="$user" --regid=tandem --init-groups --inh-caps=-all "$@"; }
if [ "${1:-}" = "--put-session" ]; then
  pane="${2:-}"; [[ "$pane" =~ ^[a-z0-9]{1,40}$ ]] || { echo "bad pane" >&2; exit 2; }
  src="$SESS_ROOT/$pane.json"
  [ -f "$src" ] || exit 0   # no shared memory yet: print nothing
  # Drop the previous prompter's account pin so any login can resume it.
  sid=$(python3 - "$src" <<'PY'
import json, re, sys
d = json.load(open(sys.argv[1]))
sid = d.get("id", "")
if not re.fullmatch(r"session_[a-z0-9_]{1,100}", sid): sys.exit(1)
print(sid)
PY
) || { echo "bad session" >&2; exit 2; }
  install -d -m 700 -o "$user" -g tandem "$home/.jcode" "$home/.jcode/sessions"
  python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
for k in [k for k in d if k == "route_api_method" or "account" in k]: d.pop(k)
d["status"] = "Closed"
json.dump(d, sys.stdout)' "$src" | as_user bash -c 'umask 077; cat > "$1.tmp" && mv -f "$1.tmp" "$1"' _ "$home/.jcode/sessions/$sid.json"
  echo "$sid"
  exit 0
fi
if [ "${1:-}" = "--take-session" ]; then
  pane="${2:-}"; sid="${3:-}"
  [[ "$pane" =~ ^[a-z0-9]{1,40}$ ]] || { echo "bad pane" >&2; exit 2; }
  [[ "$sid" =~ ^session_[a-z0-9_]{1,100}$ ]] || { echo "bad session" >&2; exit 2; }
  install -d -m 700 -o root -g root "$SESS_ROOT"
  tmp=$(mktemp "$SESS_ROOT/.in.XXXXXX")
  as_user head -c 50000000 "$home/.jcode/sessions/$sid.json" > "$tmp" || { rm -f "$tmp"; exit 1; }
  python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$tmp" || { rm -f "$tmp"; echo "bad session json" >&2; exit 1; }
  chmod 600 "$tmp" && mv -f "$tmp" "$SESS_ROOT/$pane.json"
  exit 0
fi

# Per-person app connectors (remote MCP servers). The list lives root-only, one
# file per sandbox user, and is merged into ONLY that user's mcp.json below, so
# a connector one person adds never reaches anyone else's agent.
CONN_ROOT=/srv/tandem/connectors
conn_file="$CONN_ROOT/$user.json"
if [ "${1:-}" = "--add-connector" ] || [ "${1:-}" = "--remove-connector" ]; then
  install -d -m 700 -o root -g root "$CONN_ROOT"
  op="$1"; name="${2:-}"
  [[ "$name" =~ ^[a-z][a-z0-9-]{0,29}$ ]] && [ "$name" != browser ] || { echo "bad name" >&2; exit 2; }
  # --add-connector reads {"url": "https://...", "token": "..."?} on stdin.
  head -c 20000 | python3 - "$conn_file" "$op" "$name" <<'PY' || exit 2
import json, os, re, sys, tempfile
path, op, name = sys.argv[1:4]
try: d = json.load(open(path))
except Exception: d = {}
if op == "--add-connector":
    req = json.load(sys.stdin)
    url = req.get("url", "")
    if not re.fullmatch(r"https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?", url) or len(url) > 300:
        sys.exit("bad url")
    entry = {"type": "http", "url": url}
    tok = req.get("token") or ""
    if tok:
        if not re.fullmatch(r"[A-Za-z0-9._~+/=-]{1,4000}", tok): sys.exit("bad token")
        entry["headers"] = {"Authorization": "Bearer " + tok}
    if name not in d and len(d) >= 20: sys.exit("too many connectors")
    d[name] = entry
else:
    d.pop(name, None)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f: json.dump(d, f)
os.chmod(tmp, 0o600); os.replace(tmp, path)
PY
  exit 0
fi

[ "${1:-}" = "--" ] && shift
[ "${1:-}" = "jcode" ] || { echo "only jcode allowed" >&2; exit 2; }
shift

# Optional flags, passed by the worker. Whitelisted values only.
effort=""
poke=0
while :; do
  case "${1:-}" in
    --effort) effort="${2:-}"; shift 2 ;;
    --auto-poke) poke=1; shift ;;
    *) break ;;
  esac
done
case "$effort" in ""|low|medium|high|xhigh|max) ;; *) echo "bad effort" >&2; exit 2 ;; esac
effort_env=()
[ -n "$effort" ] && effort_env=(JCODE_ANTHROPIC_REASONING_EFFORT="$effort" JCODE_OPENAI_REASONING_EFFORT="$effort")

# Give every agent its own clean browser: a fresh in-memory Chromium profile
# (never anyone's login) launched over a pipe as this sandbox user, so the
# nft rules still block private networks. Screenshots land in the workspace's
# .tandem/browser folder, which is what the live Browser view shows.
shot_dir="$top/.tandem/browser"
as_user mkdir -p "$shot_dir" 2>/dev/null || true
python3 - "$conn_file" "$shot_dir" <<'PY' | as_user bash -c 'umask 077; mkdir -p "$1/.jcode"; cat > "$1/.jcode/mcp.json.tmp" && mv -f "$1/.jcode/mcp.json.tmp" "$1/.jcode/mcp.json"' _ "$home"
import json, sys
servers = {}
try: servers.update(json.load(open(sys.argv[1])))
except Exception: pass
servers["browser"] = {
    "command": "/opt/tandem-browser/bin/tandem-browser-mcp",
    "args": [sys.argv[2]],
    "env": {"PLAYWRIGHT_BROWSERS_PATH": "/opt/tandem-browser/browsers"},
}
json.dump({"mcpServers": servers}, sys.stdout, indent=2)
PY

exec setpriv --reuid="$user" --regid=tandem --init-groups --inh-caps=-all \
  env -i HOME="$home" JCODE_HOME="$home/.jcode" USER="$user" LOGNAME="$user" \
  PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 JCODE_NO_TELEMETRY=1 JCODE_MEMORY_ENABLED=0 JCODE_RUN_AUTO_POKE=$poke \
  TERM=dumb TMPDIR="$home/tmp" "${effort_env[@]}" \
  bash -c 'umask 007; cd "$0" && exec /usr/local/bin/jcode "$@"' "$cwd_real" "$@"
